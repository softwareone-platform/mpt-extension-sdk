{
  "request": {
    "method": "GET",
    "urlPathPattern": "/public/v1/system/tasks/[^/]+",
    "customMatcher": {
      "name": "state-matcher",
      "parameters": {
        "hasContext": "{{request.pathSegments.[4]}}",
        "property": {
          "status": {
            "absent": true
          },
          "path": {
            "matches": ".*"
          }
        }
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "system/task.json.hbs"
  },
  "priority": 3,
  "serveEventListeners": [
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/devmock/deliveries/app/{{originalRequest.pathSegments.[4]}}",
        "delay": {
          "type": "fixed",
          "milliseconds": 30000
        }
      }
    }
  ]
}
