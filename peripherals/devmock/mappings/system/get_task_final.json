{
  "request": {
    "method": "GET",
    "urlPathPattern": "/public/v1/system/tasks/[^/]+",
    "customMatcher": {
      "name": "state-matcher",
      "parameters": {
        "hasContext": "{{request.pathSegments.[4]}}",
        "property": {
          "status": {
            "matches": ".*"
          }
        }
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "system/task.json.hbs",
    "transformers": [
      "response-template"
    ]
  },
  "priority": 2
}
