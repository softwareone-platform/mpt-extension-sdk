{
  "request": {
    "method": "POST",
    "urlPathPattern": "/devmock/flows/[^/]+/[^/]+"
  },
  "response": {
    "status": 202,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"started\":\"{{request.pathSegments.[2]}}\",\"task\":\"{{request.pathSegments.[3]}}\"}"
  },
  "priority": 2,
  "serveEventListeners": [
    {
      "name": "recordState",
      "parameters": {
        "context": "{{request.pathSegments.[3]}}",
        "state": {
          "path": "/api/v2/schedules/use-cases/{{request.pathSegments.[2]}}",
          "objectId": "mock.use-cases.{{request.pathSegments.[2]}}",
          "objectName": "schedule-use-case-{{request.pathSegments.[2]}}",
          "objectType": "Schedule",
          "eventType": "Schedule",
          "enqueuedAt": "{{now}}",
          "status": "null",
          "claimed": "null"
        }
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/devmock/deliveries/app/{{originalRequest.pathSegments.[3]}}",
        "delay": {
          "type": "fixed",
          "milliseconds": 500
        }
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/devmock/deliveries/{{#eq originalRequest.pathSegments.[2] 'timeout'}}app-secondary{{else}}none{{/eq}}/{{originalRequest.pathSegments.[3]}}",
        "delay": {
          "type": "fixed",
          "milliseconds": 5000
        }
      }
    }
  ]
}
