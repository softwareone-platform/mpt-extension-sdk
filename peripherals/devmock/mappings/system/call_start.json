{
  "request": {
    "method": "POST",
    "urlPathPattern": "/devmock/calls/[^/]+",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.path",
          "matches": "^/.*"
        }
      }
    ]
  },
  "response": {
    "status": 202,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"started\":\"{{jsonPath request.body '$.path'}}\",\"task\":\"{{request.pathSegments.[2]}}\"}"
  },
  "priority": 2,
  "serveEventListeners": [
    {
      "name": "recordState",
      "parameters": {
        "context": "{{request.pathSegments.[2]}}",
        "state": {
          "path": "{{jsonPath request.body '$.path'}}",
          "enqueuedAt": "{{now}}",
          "status": "null",
          "claimed": "null",
          "objectId": "null",
          "objectName": "null",
          "objectType": "null",
          "eventType": "null"
        }
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/devmock/deliveries/app/{{originalRequest.pathSegments.[2]}}",
        "delay": {
          "type": "fixed",
          "milliseconds": 500
        }
      }
    }
  ]
}
